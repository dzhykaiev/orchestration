DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestration
REDIS_URL=redis://localhost:6379
# LLM provider: "claude" (default) or "opencode"
# For per-role mapping, use ROLE_PROVIDER_MAP='{"architect":"claude","backend":"opencode"}'
LLM_PROVIDER=claude
# Optional: specific model for OpenCode (e.g., "claude-3.5-sonnet")
# OPENCODE_MODEL=claude-3.5-sonnet
PORT=3001
WEB_PORT=3000
# Shared directory for project output files (used by API and orchestrator)
# PROJECTS_DIR=./projects
NODE_ENV=development
LOG_LEVEL=debug
# Self-improvement: path to the platform's own repo (for feature board kickoff)
# SELF_REPO_PATH=./
